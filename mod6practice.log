mysql> DELIMITER $$
mysql> 
mysql> CREATE FUNCTION ClassDiscount(p_Tier VARCHAR(10))
    -> RETURNS DECIMAL(4,2)
    -> DETERMINISTIC
    -> BEGIN
    ->     IF p_Tier = 'Gold' THEN
    ->         RETURN 0.20;
    ->     ELSEIF p_Tier = 'Silver' THEN
    ->         RETURN 0.10;
    ->     ELSE
    ->         RETURN 0.00;
    ->     END IF;
    -> END $$
