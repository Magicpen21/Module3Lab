mysql> DELIMITER $$
mysql> 
mysql> CREATE FUNCTION MemberYearsActive(p_JoinDate DATE)
    -> RETURNS INT
    -> DETERMINISTIC
    -> BEGIN
    ->     RETURN TIMESTAMPDIFF(YEAR, p_JoinDate, CURDATE());
    -> END $$
